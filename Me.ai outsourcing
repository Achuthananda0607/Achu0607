body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #fff;
    color: #333;
}

header {
    background-color: #ff9933; /* Saffron from India's flag */
    padding: 20px;
    text-align: center;
}

header nav ul {
    list-style-type: none;
    padding: 0;
}

header nav ul li {
    display: inline;
    margin-right: 20px;
}

header nav ul li a {
    color: #fff;
    text-decoration: none;
    font-weight: bold;
}

.hero {
    background-color: #000080; /* Navy blue (US flag) */
    color: white;
    padding: 50px;
    text-align: center;
}

footer {
    background-color: #ff9933; /* Saffron from India's flag */
    color: white;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

h1, h2 {
    font-size: 2.5em;
}

ul {
    list-style-type: none;
}

.services, .about, .contact {
    padding: 30px;
    text-align: center;
}

.services ul {
    padding: 0;
    list-style-type: none;
}

.services ul li {
    margin: 10px 0;
}
